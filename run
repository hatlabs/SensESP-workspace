#!/usr/bin/env bash
#
# usage: ./run command [argument ...]
#
# Commands for managing the SensESP workspace.
#
# See https://death.andgravity.com/run-sh
# for an explanation of how it works and why it's useful.

set -o nounset
set -o pipefail
set -o errexit

# Change the current directory to the project root.
PROJECT_ROOT=${0%/*}
if [[ $0 != $PROJECT_ROOT && $PROJECT_ROOT != "" ]]; then
  cd "$PROJECT_ROOT"
fi
readonly PROJECT_ROOT=$(pwd)

readonly SCRIPT="$PROJECT_ROOT/$(basename "$0")"

################################################################################
# Repository Definitions
#
# Format: name url branch
# Using a function instead of associative arrays for bash 3.2 compatibility
# (macOS ships bash 3.2 which lacks declare -A).

repo_list() {
  cat <<'REPOS'
SensESP                    https://github.com/SignalK/SensESP.git                     main
ReactESP                   https://github.com/mairas/ReactESP.git                     master
NMEA0183                   https://github.com/SensESP/NMEA0183.git                    main
OneWire                    https://github.com/SensESP/OneWire.git                     main
VEDirect                   https://github.com/SensESP/VEDirect.git                    main
MAX31856                   https://github.com/SensESP/MAX31856.git                    main
SensESP-project-template   https://github.com/SensESP/SensESP-project-template.git    main
Tutorial-BMP280            https://github.com/SensESP/Tutorial-BMP280.git             main
HALMET-example-firmware    https://github.com/hatlabs/HALMET-example-firmware.git      main
HALSER-default-firmware    https://github.com/hatlabs/HALSER-default-firmware.git      main
HALSER-ais-interface       https://github.com/hatlabs/HALSER-ais-interface.git         main
HALSER-wind-interface      https://github.com/hatlabs/HALSER-wind-interface.git        main
HALSER-cv7-wind-interface  https://github.com/BoatHacks/HALSER-cv7-wind-interface.git  main
HALSER-cv7-hwt3100-interface https://github.com/humppafreak/HALSER-cv7-hwt3100-interface.git main
signalk-halmet-vacuflush   https://github.com/joelkoz/signalk-halmet-vacuflush.git    main
signalk-halmet-searay-system-monitor https://github.com/joelkoz/signalk-halmet-searay-system-monitor.git main
HALSER-attitude-sensor     https://github.com/hatlabs/HALSER-attitude-sensor.git       main
Morticia-eCompass          https://github.com/jrehm/Morticia-eCompass.git              main
REPOS
}

# Source additional repository definitions if present.
for f in "$PROJECT_ROOT"/repos.*.sh; do
  if [[ -f "$f" ]]; then
    source "$f"
  fi
done

################################################################################
# Internal Helpers

function _install_system_packages {
  # On Debian/Ubuntu, detect and install missing basic tools via apt.
  # This handles fresh Ubuntu installs where git, curl, python3 aren't present.
  if ! command -v apt-get &> /dev/null; then
    return
  fi

  local missing=()
  command -v curl &> /dev/null   || missing+=(curl)
  command -v python3 &> /dev/null || missing+=(python3)

  if [[ ${#missing[@]} -eq 0 ]]; then
    return
  fi

  echo "Installing missing system packages: ${missing[*]}"
  echo "  (This requires sudo and may ask for your password.)"
  sudo apt-get update -qq && sudo apt-get install -y -qq "${missing[@]}"
  echo ""
}

################################################################################
# Initialization

function init {
  #@ Set up the workspace: install tools, clone reference repos
  #@ Category: Setup

  echo "Setting up SensESP workspace..."
  echo ""

  # On Linux, install missing basic tools via apt if available
  _install_system_packages

  # Check git
  if ! command -v git &> /dev/null; then
    echo "ERROR: git is not installed."
    echo "Please install git and try again."
    exit 1
  fi
  echo "  git: $(git --version)"

  # Check curl (needed for uv installer)
  if ! command -v curl &> /dev/null; then
    echo "ERROR: curl is not installed."
    echo "Please install curl and try again."
    exit 1
  fi

  # Check python3
  if ! command -v python3 &> /dev/null; then
    echo "ERROR: python3 is not installed."
    echo "Please install Python 3 and try again."
    exit 1
  fi
  echo "  python3: $(python3 --version)"

  # Check/install uv
  if ! command -v uv &> /dev/null; then
    echo ""
    echo "Installing uv (Python package manager)..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
    # Source the updated PATH
    export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
    if ! command -v uv &> /dev/null; then
      echo "ERROR: uv installation failed."
      echo "Please install uv manually: https://docs.astral.sh/uv/getting-started/installation/"
      exit 1
    fi
  fi
  echo "  uv: $(uv --version)"

  # Check/install PlatformIO
  if ! command -v pio &> /dev/null; then
    echo ""
    echo "Installing PlatformIO..."
    uv tool install platformio
    if ! command -v pio &> /dev/null; then
      echo "WARNING: PlatformIO installation may require restarting your shell."
      echo "After restarting, verify with: pio --version"
    fi
  fi
  if command -v pio &> /dev/null; then
    echo "  pio: $(pio --version 2>&1 | head -1)"
  fi

  # Install pyserial for serial monitoring
  echo ""
  echo "Installing pyserial..."
  uv pip install --system pyserial 2>/dev/null || pip3 install pyserial 2>/dev/null || true

  # Create directories
  mkdir -p ref projects

  # Clone repos
  echo ""
  repos:clone

  # Platform-specific guidance
  echo ""
  _platform_guidance

  echo ""
  echo "=========================================="
  echo "  Workspace setup complete!"
  echo ""
  echo "  Next steps:"
  echo "    1. Open Claude Code in this directory"
  echo "    2. Describe what you want to build"
  echo ""
  echo "  Example:"
  echo "    \"I want to monitor my engine"
  echo "     temperature using HALMET\""
  echo "=========================================="
}

function _platform_guidance {
  # Detect platform and provide relevant guidance
  local system
  system="$(uname -s)"

  case "$system" in
    Linux)
      # Check for WSL
      if grep -qi microsoft /proc/version 2>/dev/null; then
        echo "NOTE: WSL detected."
        echo "  USB devices require usbipd-win for passthrough."
        echo "  See: https://learn.microsoft.com/en-us/windows/wsl/connect-usb"
      else
        # Check dialout group
        if ! groups | grep -q dialout 2>/dev/null; then
          echo "NOTE: You may need to add yourself to the 'dialout' group"
          echo "  for serial port access:"
          echo "    sudo usermod -a -G dialout \$USER"
          echo "  Then log out and back in."
        fi
      fi
      ;;
  esac
}

################################################################################
# Repository Management Commands

function repos:clone {
  #@ Clone any missing reference repos into ref/
  #@ Category: Repository Management
  echo "Checking reference repositories..."

  local cloned=0
  local skipped=0
  local failed=0

  repo_list | grep -v '^#' | grep -v '^\s*$' | while read -r name url branch; do
    if [[ -d "ref/$name" ]]; then
      echo "  $name (already cloned)"
      # Can't increment skipped in subshell, but that's OK for display
    else
      echo "  Cloning $name..."
      if git clone --depth 1 -b "$branch" "$url" "ref/$name" 2>/dev/null; then
        echo "    Done."
      else
        echo "    WARNING: Failed to clone $name. Skipping."
      fi
    fi
  done

  echo ""
  echo "Reference repos are in ref/"
}

function repos:pull {
  #@ Update all reference repos to latest
  #@ Category: Repository Management
  echo "Updating reference repositories..."

  repo_list | grep -v '^#' | grep -v '^\s*$' | while read -r name url branch; do
    if [[ ! -d "ref/$name" ]]; then
      echo "  $name: not cloned (run ./run repos:clone)"
      continue
    fi

    echo "  Updating $name..."
    # repos:clone makes shallow clones; a shallow clone cannot fast-forward
    # once the remote branch moves past its graft point, so the first update
    # fetches the full history. Later updates are plain fast-forwards.
    # (A string, not an array: bash 3.2 rejects an empty array under nounset.)
    local unshallow=""
    if [[ "$(git -C "ref/$name" rev-parse --is-shallow-repository)" == "true" ]]; then
      unshallow="--unshallow"
    fi
    local current
    current=$(git -C "ref/$name" branch --show-current 2>/dev/null || true)
    if ! git -C "ref/$name" fetch $unshallow origin "$branch" 2>/dev/null; then
      echo "    WARNING: Failed to fetch $name."
    elif [[ "$current" != "$branch" ]]; then
      echo "    WARNING: $name is on branch '$current', not '$branch'; fetched, not merged."
    elif git -C "ref/$name" merge --ff-only FETCH_HEAD >/dev/null 2>&1; then
      echo "    Done."
    else
      echo "    WARNING: Failed to fast-forward $name."
    fi
  done
}

function repos:status {
  #@ Show clone status of all reference repos
  #@ Category: Repository Management
  echo "Reference repository status:"
  echo ""

  repo_list | grep -v '^#' | grep -v '^\s*$' | while read -r name url branch; do
    if [[ -d "ref/$name" ]]; then
      local current_branch
      current_branch=$(cd "ref/$name" && git branch --show-current 2>/dev/null || echo "unknown")
      echo "  $name: cloned (branch: $current_branch)"
    else
      echo "  $name: NOT CLONED"
    fi
  done
}

################################################################################
# Firmware Commands

function deploy {
  #@ Build a project's *_espidf env and OTA-flash it (espota.py; no platformio.ini edits)
  #@ Category: Firmware
  export PATH="$HOME/.local/bin:$PATH"

  local project="${1:-}"
  local host="${2:-}"

  if [[ -z "$project" ]]; then
    echo "Usage: ./run deploy <project> [host]"
    echo ""
    echo "  Builds projects/<project>'s default (*_espidf) env and OTA-flashes it"
    echo "  over the LAN with espota.py -- never 'pio run -t upload', so"
    echo "  platformio.ini is left untouched."
    echo "  host defaults to the device's set_hostname(...) + '.hurma'."
    exit 1
  fi

  local proj_dir="$PROJECT_ROOT/projects/$project"
  local ini="$proj_dir/platformio.ini"
  local main_cpp="$proj_dir/src/main.cpp"
  if [[ ! -f "$ini" ]]; then
    echo "ERROR: no such project (missing $ini)"
    exit 1
  fi

  # Build env: the project's default_envs, which is the *_espidf variant by
  # convention -- it builds ESP-IDF from source so sdkconfig (the dynamic TLS
  # buffer) applies, required for a stable TLS Signal K link.
  local env
  env=$(grep -E '^[[:space:]]*default_envs[[:space:]]*=' "$ini" | head -1 \
        | sed -E 's/.*=[[:space:]]*//; s/[[:space:]].*//' || true)
  if [[ -z "$env" ]]; then
    echo "ERROR: could not read default_envs from $ini"
    exit 1
  fi

  # OTA host and password, derived from the firmware source when not supplied.
  if [[ -z "$host" ]]; then
    local hostname
    hostname=$(grep -oE 'set_hostname\("[^"]+"\)' "$main_cpp" 2>/dev/null | head -1 \
               | sed -E 's/.*"([^"]+)".*/\1/' || true)
    if [[ -z "$hostname" ]]; then
      echo "ERROR: no host given and could not derive set_hostname() from $main_cpp"
      exit 1
    fi
    host="$hostname.hurma"
  fi
  local auth
  auth=$(grep -oE 'enable_ota\("[^"]+"\)' "$main_cpp" 2>/dev/null | head -1 \
         | sed -E 's/.*"([^"]+)".*/\1/' || true)
  if [[ -z "$auth" ]]; then
    echo "ERROR: could not derive the OTA password from enable_ota() in $main_cpp"
    exit 1
  fi

  local espota="$HOME/.platformio/packages/framework-arduinoespressif32/tools/espota.py"
  if [[ ! -f "$espota" ]]; then
    echo "ERROR: espota.py not found (build the project once to install the toolchain):"
    echo "  $espota"
    exit 1
  fi

  echo "Deploying $project [$env] -> $host"
  echo ""

  # -j2 keeps headroom on the on-boat host, which also runs live services.
  ( cd "$proj_dir" && pio run -e "$env" -j2 )

  local bin="$proj_dir/.pio/build/$env/firmware.bin"
  if [[ ! -f "$bin" ]]; then
    echo "ERROR: firmware not found at $bin"
    exit 1
  fi

  echo ""
  echo "OTA-flashing -> $host (espota.py) ..."
  # -d prints the final 'Result: OK'; without it the success line is suppressed.
  python3 "$espota" -i "$host" -p 3232 -a "$auth" -f "$bin" -d

  echo ""
  echo "Flashed $host. Now confirm the device rebooted and its data still flows"
  echo "(web_log_monitor.py / Signal K) -- a flash can regress unrelated behavior."
}

################################################################################
# Help System

function help {
  #@ Show this help message
  #@ Category: Core
  echo "SensESP Workspace"
  echo ""
  echo "Available commands:"

  # Extract function definitions and their help comments
  awk '/^function / {
    fname = $2
    sub(/[({].*/, "", fname)
    if (fname ~ /^_/) next
    getline
    if ($0 ~ /#@/) {
      desc = $0
      sub(/.*#@ /, "", desc)
      sub(/ *$/, "", desc)
      getline
      if ($0 ~ /#@ Category:/) {
        cat = $0
        sub(/.*Category: /, "", cat)
        sub(/ *$/, "", cat)
        if (!seen[cat]++) categories[++cat_count] = cat
        commands[cat, ++cmd_count[cat]] = fname
        descriptions[cat, cmd_count[cat]] = desc
      }
    }
  }
  END {
    for (i = 1; i <= cat_count; i++) {
      cat = categories[i]
      print "\n  " cat ":"
      for (j = 1; j <= cmd_count[cat]; j++) {
        printf "    %-30s %s\n", commands[cat, j], descriptions[cat, j]
      }
    }
  }' "$0"

  echo ""
  echo "Usage: ./run <command> [arguments...]"
}

################################################################################
# Commands end.

# Support --help as an alias for help.
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  set -- help
fi

TIMEFORMAT=$'\nTask completed in %3lR'
time "${@:-help}"
